{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 512,
      "maxDuration": 30,
      "excludeFiles": "{public/build/assets/**,public/img/!(manifest.json),public/js/**,public/css/**,public/fonts/**,public/docs/**,public/vendor/**,tests/**,node_modules/**,resources/images/**,vendor/aws/aws-sdk-php/src/data/!(s3)/**}"
    }
  },
  "routes": [
    {
      "src": "/(build|img|fonts|docs|css|js)/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/(index\\.php)?",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
